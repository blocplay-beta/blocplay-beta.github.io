<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Connexion - BlocPlay</title>

  <link rel="icon" href="logo.ico">

  <style>
    body {
      font-family: Arial;
      background: #0b0f1a;
      color: white;
      display: flex;
      flex-direction: column;
      justify-content: center;
      align-items: center;
      height: 100vh;
      padding: 10px;
    }

    .box {
      background: #141a2a;
      padding: 30px;
      border-radius: 15px;
      width: 280px;
    }

    h2 { text-align: center; }

    input {
      width: 100%;
      padding: 10px;
      margin: 8px 0;
      border-radius: 8px;
      border: none;
    }

    button {
      width: 100%;
      padding: 12px;
      border: none;
      border-radius: 10px;
      background: linear-gradient(135deg,#8b5cf6,#22d3ee);
      font-weight: bold;
      cursor: pointer;
    }

    a {
      color: #22d3ee;
      display: block;
      text-align: center;
      margin-top: 10px;
      text-decoration: none;
    }
    #color-status {
      width: 280px;
      min-height: 50px;
      background-color: #2293aa;
      border-radius: 5px 10px 10px 5px;
      align-items: stretch;
      margin-top: 10px;
    }
    #status {
      display: flex;
      width: calc(100% - 6px);
      background-color: #1e293b;
      margin-left: auto;
      border-radius: 5px;
      align-items: center;
      box-sizing: border-box;
      padding: 5px;
    }
    #status-txt {
      font-family: Arial, sans-serif;
      color: #90faff;
      margin: 0;
    }
  </style>
</head>

<body>

<div class="box">
  <h2>Connexion</h2>

  <input type="email" id="email" placeholder="Email">
  <input type="password" id="password" placeholder="Mot de passe">

  <button onclick="login()">Se connecter</button>

</div>
<div id="color-status" style="display: none"><div id="status"><p id="status-txt">text</p></div></div>
<script type="module">
  function status(text, color) {
    const statusColor = document.getElementById("color-status")
    const status = document.getElementById("status")
    const statusTxt = document.getElementById("status-txt")
    statusColor.style.backgroundColor = color;
    statusColor.style.display = "flex";
    statusTxt.textContent = text;
  }
  import { initializeApp } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-app.js";
  import { getAuth, signInWithEmailAndPassword } from "https://www.gstatic.com/firebasejs/10.12.2/firebase-auth.js";

  const firebaseConfig = {
    apiKey: "AIzaSyAQHLAG_Dvnc-a8LDJ__05oRwMmEtUkn04",
    authDomain: "blocplay-a9417.firebaseapp.com",
    projectId: "blocplay-a9417",
  };

  const app = initializeApp(firebaseConfig);
  const auth = getAuth(app);

  window.login = async function () {
    const email = document.getElementById("email").value;
    const password = document.getElementById("password").value;

    try {
      await signInWithEmailAndPassword(auth, email, password);

      status("Connexion réussi !", "#00ff00");
      window.location.href = "/profile/request-google?id=1885365254349732354566555495235791";

    } catch (error) {
      status("Email ou mot de passe incorrect", "#ff0000");
    }
  }
</script>

<script type="module" src="/login/firebase-auth.js"></script>

</body>
</html>
